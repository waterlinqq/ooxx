# EC2 / production — 複製為 .env 後填入（勿 commit .env）
POSTGRES_PASSWORD=change-me-to-a-strong-password

# 本機 build：用 CloudFront HTTPS 同源（避免 Mixed Content）
# 執行 ./deploy/setup-cloudfront.sh 取得網址後填入
VITE_API_BASE=https://YOUR_CLOUDFRONT_DOMAIN.cloudfront.net

# deploy-server.sh 使用
EC2_HOST=YOUR_ELASTIC_IP
EC2_KEY=~/.ssh/ooxx.pem
EC2_USER=ec2-user
